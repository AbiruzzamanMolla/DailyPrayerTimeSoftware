<Window x:Class="DailyPrayerTime.Native.Views.AuthPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Sync"
        Height="320" Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource ThemePopupBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,15">
                <TextBlock Text="☁" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Cycle_CloudSync}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Cycle_SyncEnabled}" FontSize="11" Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Button x:Name="GoogleSignInBtn" Click="GoogleSignIn_Click" Background="#4285F4" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold" Padding="20,10" HorizontalAlignment="Stretch" Cursor="Hand" BorderThickness="0" Margin="0,0,0,8">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="G" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Sign in with Google" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeWarningBrush}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Row="2" Content="{DynamicResource Cancel}" Background="Transparent" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Foreground="{DynamicResource ThemeTextBrush}" Padding="20,8" HorizontalAlignment="Center" Click="Cancel_Click" Cursor="Hand" FontSize="11">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
