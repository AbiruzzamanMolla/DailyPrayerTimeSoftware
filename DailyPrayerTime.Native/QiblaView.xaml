<UserControl x:Class="DailyPrayerTime.Native.QiblaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="15,10">
            <TextBlock Text="{DynamicResource Qibla_Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,5,0,15"/>

            <Border Background="{DynamicResource ThemeCardBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Padding="15,12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid HorizontalAlignment="Center" Width="240" Height="240">
                        <Ellipse Width="220" Height="220" Stroke="{DynamicResource ThemeCardBorderBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="200" Height="200" Stroke="{DynamicResource ThemeCardBgBrush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="180" Height="180" Stroke="{DynamicResource ThemeCardBgBrush}" StrokeThickness="1" StrokeDashArray="4,4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 
                        <TextBlock Text="N" Foreground="{DynamicResource ThemeSecondaryBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="S" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="E" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Text="W" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
 
                        <Polygon x:Name="QiblaArrow" Points="120,25 112,65 128,65" Fill="{DynamicResource ThemeSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Polygon.RenderTransform>
                                <RotateTransform x:Name="ArrowRotation" CenterX="120" CenterY="120"/>
                            </Polygon.RenderTransform>
                        </Polygon>
 
                        <Rectangle x:Name="ArrowShaft" Width="4" Height="65" Fill="{DynamicResource ThemeSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,55">
                            <Rectangle.RenderTransform>
                                <RotateTransform x:Name="ShaftRotation" CenterX="2" CenterY="-65"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
 
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource ThemeSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource ThemePrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
 
                    <TextBlock x:Name="BearingText" Text="--°" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="DirectionText" Text="" Foreground="{DynamicResource ThemeTextBrush}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock x:Name="LocationText" Text="" Foreground="{DynamicResource ThemeTextBrush}" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
 
            <Border Background="{DynamicResource ThemeCardBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Padding="15,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Qibla_Note}" Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border x:Name="RefreshBtn" Background="{DynamicResource ThemeButtonBgBrush}" CornerRadius="8" Padding="12,8" Cursor="Hand" HorizontalAlignment="Center" MouseLeftButtonUp="RefreshBtn_Click">
                        <TextBlock Text="{DynamicResource Qibla_Refresh}" Foreground="{DynamicResource ThemeButtonTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
